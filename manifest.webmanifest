{
    "name": "Image To Bin",
    "short_name": "Image To Bin",
    "lang": "zh-CN",
    "description": "将图片批量转换为 Flash BIN，并生成 C 头文件与 CSV 地址表。",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#edf1fb",
    "theme_color": "#edf1fb",
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "file_handlers": [
        {
            "action": "./",
            "accept": {
                "application/json": [".itbproj"]
            },
            "launch_type": "single-client"
        }
    ]
}
